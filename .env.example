# 개발 서버에서 /api 요청을 프록시할 졸업요건 백엔드 주소
VITE_API_PROXY_TARGET=http://localhost:8080

# /abeek 요청을 프록시할 공학인증(ABEEK) 백엔드 주소
VITE_ABEEK_PROXY_TARGET=http://localhost:8001

# (선택) 프록시 대신 절대 URL로 직접 호출할 경우 사용. 보통은 비워둡니다.
# VITE_API_BASE_URL=https://api.example.com

# (선택) 공학인증 API를 직접 호출할 때의 주소. 기본값은 /abeek입니다.
# VITE_ABEEK_API_BASE=https://abeek.example.com

# VITE_ 변수는 브라우저 번들에 포함될 수 있으므로 비밀키를 넣지 마세요.
